{
  "mcpServers": {
    "calc-stats": {
      "command": ".venv/bin/python",
      "args": ["-m", "sqwakvox.mcp_calc_server"],
      "client_session_timeout_seconds": 300
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp<2.0", "mcp-server-fetch"],
      "client_session_timeout_seconds": 300
    },
    "sqlite": {
      "command": "uvx",
      "args": ["--with", "mcp<2.0", "mcp-server-sqlite", "--db-path", "sqwakvox_mcp.db"],
      "client_session_timeout_seconds": 300
    },
    "ascii-charts": {
      "command": "npx",
      "args": ["-y", "mcp-ascii-charts"],
      "client_session_timeout_seconds": 300
    }
  }
}
