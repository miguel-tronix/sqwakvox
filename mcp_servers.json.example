{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "client_session_timeout_seconds": 300
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "/home/migtronix/db.sqlite"
      ],
      "client_session_timeout_seconds": 300
    },
    "calc-stats": {
      "command": ".venv/bin/python",
      "args": ["-m", "sqwakvox.mcp_calc_server"],
      "client_session_timeout_seconds": 300
    },
    "calc-stats-http": {
      "url": "http://127.0.0.1:8000/mcp/",
      "transport": "http",
      "client_session_timeout_seconds": 300
    }
  }
}
